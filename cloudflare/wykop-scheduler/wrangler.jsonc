{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wykop-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["10 19 * * MON-FRI"]
  },
  "durable_objects": {
    "bindings": [{ "name": "INDEX_RETRIES", "class_name": "IndexRetryCoordinator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["IndexRetryCoordinator"] }],
  "vars": {
    "SCHEDULER_ENABLED": "true",
    "APPWRITE_ENDPOINT": "https://fra.cloud.appwrite.io/v1",
    "APPWRITE_PROJECT_ID": "wykopindex",
    "APPWRITE_WYKOP_INDEX_FUNCTION_ID": "696171ec001de97fe3c0"
  }
}
